# Copy to .env and adjust. These are read as environment variables by Spring Boot.

# --- Server ---
PORT=8080

# --- PostgreSQL ---
DB_URL=jdbc:postgresql://localhost:5432/kloudspot
DB_USERNAME=kloudspot
DB_PASSWORD=kloudspot

# --- JWT ---
# Optional: if unset, a random secret is generated at startup (sessions reset on
# restart). Set at least 32 random characters to keep sessions stable.
# JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_EXPIRATION_MS=86400000

# --- CORS: comma separated list of browser origins allowed to call the API ---
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Activate the prod profile to enforce the mandatory values above ---
SPRING_PROFILES_ACTIVE=

# --- OpenAPI / Swagger UI ---
OPENAPI_ENABLED=true
