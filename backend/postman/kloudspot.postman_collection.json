{
  "info": {
    "_postman_id": "b2c7f3a1-4e6d-4b8a-9f1c-kloudspot00001",
    "name": "Kloudspot Employee Management API",
    "description": "Collection for the Kloudspot Employee Management REST API. Sign in first: the login request stores the JWT in the {{token}} collection variable, which every other request uses via Bearer auth.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "departmentId",
      "value": ""
    },
    {
      "key": "employeeId",
      "value": ""
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Sign in",
          "auth": {
            "type": "noauth"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.token) {",
                  "    pm.collectionVariables.set('token', json.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@kloudspot.com\",\n  \"password\": \"admin123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "login"
              ]
            },
            "description": "Returns a JWT and the signed-in admin. The token is saved to {{token}}."
          }
        }
      ]
    },
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "auth": {
            "type": "noauth"
          },
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "health"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Employees",
      "item": [
        {
          "name": "List employees",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/emp?page=1&size=10&search=&department=&status=",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "emp"
              ],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "size", "value": "10" },
                { "key": "search", "value": "" },
                { "key": "department", "value": "" },
                { "key": "status", "value": "" }
              ]
            },
            "description": "Paginated list. search matches name/email/empId; status is active or inactive."
          }
        },
        {
          "name": "Create employee",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"empId\": \"EMP-1001\",\n  \"fullName\": \"Aarav Sharma\",\n  \"email\": \"aarav.sharma@kloudspot.com\",\n  \"phoneNumber\": \"9876543210\",\n  \"departmentId\": \"00000000-0000-0000-0000-000000000000\",\n  \"designation\": \"Software Engineer\",\n  \"dateOfJoining\": \"2024-06-01\",\n  \"salary\": 650000,\n  \"status\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/emp/add",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "emp",
                "add"
              ]
            },
            "description": "Replace departmentId with a real department id returned by Create department."
          }
        },
        {
          "name": "Get employee",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/emp/{{employeeId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "emp",
                "{{employeeId}}"
              ]
            }
          }
        },
        {
          "name": "Update employee",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"empId\": \"EMP-1001\",\n  \"fullName\": \"Aarav Sharma\",\n  \"email\": \"aarav.sharma@kloudspot.com\",\n  \"phoneNumber\": \"9876543210\",\n  \"departmentId\": \"00000000-0000-0000-0000-000000000000\",\n  \"designation\": \"Senior Software Engineer\",\n  \"dateOfJoining\": \"2024-06-01\",\n  \"salary\": 850000,\n  \"status\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/emp/{{employeeId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "emp",
                "{{employeeId}}"
              ]
            }
          }
        },
        {
          "name": "Delete employee",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/emp/{{employeeId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "emp",
                "{{employeeId}}"
              ]
            }
          }
        },
        {
          "name": "Export employees (CSV)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/emp/export?search=&department=&status=",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "emp",
                "export"
              ],
              "query": [
                { "key": "search", "value": "" },
                { "key": "department", "value": "" },
                { "key": "status", "value": "" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Departments",
      "item": [
        {
          "name": "List departments",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/departments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "departments"
              ]
            }
          }
        },
        {
          "name": "Create department",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.id) {",
                  "    pm.collectionVariables.set('departmentId', json.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Engineering\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/departments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "departments"
              ]
            }
          }
        }
      ]
    },
    {
