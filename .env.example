# Docker Compose variables. Every value has a sensible default, so this file is
# optional: `docker compose up --build` works with no configuration at all.
# Copy to .env only if you want to override something.

# Postgres is provisioned inside Docker automatically; these are the database
# name and credentials it is created with (the backend gets the matching URL).
DB_NAME=kloudspot
DB_USERNAME=kloudspot
DB_PASSWORD=kloudspot

# Optional. If left unset the backend generates a random secret at startup, so
# you never ship a known key (sessions reset on each restart). Set a fixed value
# of 32+ characters to keep sessions stable across restarts.
# JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_EXPIRATION_MS=86400000

# Origins allowed to call the API (comma separated). Defaults to the frontend
# origin derived from FRONTEND_PORT; set this explicitly when serving on a domain.
# CORS_ALLOWED_ORIGINS=https://employees.example.com

# Serve Swagger UI on the backend (http://localhost:8080/swagger-ui.html).
OPENAPI_ENABLED=true

BACKEND_PORT=8080
FRONTEND_PORT=3000
